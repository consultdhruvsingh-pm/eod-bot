# Copy this file to .env and fill in your values
# Never commit .env to git!

# Connie API key (starts with sk_), used with the Tool API at https://api.connie.ai
# Get it from: Connie → Settings → Developers → API keys. The key reads Tasks and
# members with the permissions of the member it is linked to.
CONNIE_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Connie workspace ID (the UUID after connie.ai/ in the app's address).
# Must be the workspace the API key belongs to.
CONNIE_WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# Slack Bot Token (starts with xoxb-)
# Get it from: https://api.slack.com/apps → Your App → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx

# Morning plan (morning.js, run by a Render Cron Job)
# Slack channel ID to post in. The bot must be a member of the channel.
MORNING_CHANNEL=C0XXXXXXXXX
# Comma-separated emails of the developers to include (same in Slack and Connie)
MORNING_DEVS=dev1@example.com,dev2@example.com

# Port (Render sets this automatically, don't change)
PORT=3000
