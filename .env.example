# Copy this file to .env and fill in your values
# Never commit .env to git!

# Linear API Key
# Get it from: https://linear.app/settings/api → "Personal API keys" → Create key
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Slack Bot Token (starts with xoxb-)
# Get it from: https://api.slack.com/apps → Your App → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx

# Your Linear team name (e.g. "Engineering", "Product")
# Find it at: https://linear.app/[your-workspace]/settings/teams
LINEAR_TEAM_NAME=Engineering

# Port (Render sets this automatically, don't change)
PORT=3000
